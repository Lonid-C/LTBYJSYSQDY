# macOS and Python caches
.DS_Store
**/.DS_Store
__pycache__/
**/__pycache__/
*.py[cod]

# Local orchestration, temporary renders, logs, and teammate snapshots
tmp/

# Colab execution caches and raw LP certificates can be regenerated.
results/q2_planning_v1/checkpoints/
results/q2_planning_v1/certificates/
results/q2_hybrid_v1/checkpoints/

# Month-end checkpoint dumps superseded byte-for-byte by the final CSV.
results/**/*.partial.csv

# Working-tree copy of the previous H0 submission workbook; the original
# revision is already preserved in git history at fc57462.
result2_H0_backup.xlsx

# Never commit local credentials or environment files.
.env
.env.*
*.pem
*.key
*oauth*
*credential*
*token*

# Local agent session state and working notes (not deliverables).
.workbuddy/
.workbuddy-ai/
